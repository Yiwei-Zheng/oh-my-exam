{
  "name": "oh-my-exam-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "vue-i18n": "11.2.8",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@typescript-eslint/parser": "8.55.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.4.0",
    "globals": "17.11.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.3.11"
  }
}
