# Copy to a service-owned environment file outside the repository in production.
OME_JWT_SECRET=replace-with-at-least-32-random-bytes
OME_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OME_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
OME_SECURE_COOKIES=false
OME_CORS_ORIGINS=http://127.0.0.1:4173
# Default is process-local and suitable for the documented single-worker setup.
# Use a limits-supported Redis URI before enabling multiple API workers.
# OME_LOGIN_RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/1

# Optional path overrides. Defaults already point below backend/data.
# OME_DATABASE_PATH=/srv/oh-my-exam/backend/data/databases/global_exam_catalog.sqlite
# OME_APP_DATABASE_PATH=/srv/oh-my-exam/backend/data/application.sqlite3
# OME_PAPER_ROOT=/srv/oh-my-exam/backend/data/raw_papers
# OME_QUESTION_IMAGE_ROOT=/srv/oh-my-exam/backend/data/processed_questions

# Optional full-pipeline override as a JSON string array. When omitted, the
# packaged candidate-build, validation and atomic catalog activation command runs.
# OME_QUESTION_UPDATE_COMMAND_JSON=["/srv/oh-my-exam/.venv/bin/python","/srv/oh-my-exam/backend/scripts/update_catalog.py"]
